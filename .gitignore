# Dependencies
node_modules/

# Android build output and generated Capacitor files
android/.gradle/
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json

# Local machine config
android/local.properties

# Signing material — never commit
android/keystore.properties
android/*.jks
android/*.keystore

# Logs and editor cruft
*.log
.DS_Store
Thumbs.db
.idea/
*.iml

# Dashboard editor runtime files (the design folder itself is committed)
designs/*/.artifact-server.json
designs/*/.artifact-server.log
designs/*/.sharing.json
