{
  "text": "<style>\n  /* Both tabs share cherina-pod's tokens and one layout skeleton. */\n  .hw { --bg:#F5F5F7; --surface:#FFFFFF; --ink:#1D1D1F; --ink2:#6E6E73; --ink3:#AEAEB2;\n        --line:#E5E5EA; --track:rgba(118,118,128,.12); --acc:#0071E3; --acc-soft:rgba(0,113,227,.10);\n        --acc-ink:#0066CC; --fire:#FF6B00; --ease:cubic-bezier(.22,.8,.24,1);\n        --ui: -apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Segoe UI\", \"PingFang SC\",\n              \"Microsoft YaHei\", sans-serif;\n        font-family: var(--font-anthropic-sans); color: var(--color-fg); }\n  .hw h1 { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: clamp(1.7rem, 3.4vw, 2.4rem);\n           letter-spacing: -.01em; margin: .2rem 0 .5rem; }\n  .hw h2 { font-size: 1rem; font-weight: 500; margin: 0 0 .2rem; }\n  .hw .kicker { margin: 0; font-size: .68rem; letter-spacing: .2em; text-transform: uppercase; color: var(--color-fg-muted); }\n  .hw .lead { margin: 0 0 1.6rem; max-width: 48rem; color: var(--color-fg-muted); line-height: 1.6; }\n  .hw .sub { margin: 0 0 1rem; font-size: .82rem; color: var(--color-fg-muted); }\n  .hw section { margin-bottom: 2.2rem; }\n  .hw .grid3 { display: grid; gap: var(--cds-gap-md, 1rem);\n               grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); }\n  .hw figure { margin: 0; }\n  .hw figcaption { font-size: .8rem; font-weight: 500; margin-bottom: .5rem; display: flex; gap: .4rem; align-items: baseline; }\n  .hw figcaption span { font-weight: 400; color: var(--color-fg-muted); font-size: .72rem; }\n  .hw .note { margin: .55rem 0 0; font-size: .74rem; line-height: 1.55; color: var(--color-fg-muted); }\n\n  /* ---------- the shared skeleton, drawn once ---------- */\n  .hw .skel { display: flex; flex-wrap: wrap; gap: .5rem; align-items: stretch; margin-top: .7rem; }\n  .hw .sk { flex: 1 1 9rem; border: 1px dashed var(--color-border-line); border-radius: 10px; padding: .55rem .65rem; }\n  .hw .sk b { display: block; font-size: .78rem; font-weight: 500; }\n  .hw .sk span { display: block; font-size: .7rem; color: var(--color-fg-muted); margin-top: .15rem; line-height: 1.5; }\n\n  /* translation popover, anchored to the pressed sentence */\n  .hw .sent-line { margin: 6px 0 0; }\n  .hw .sent-line mark { background: var(--acc-soft); color: var(--acc-ink); border-radius: 3px; padding: 0 2px; }\n  .hw .pop { position: relative; margin: 9px 0 0 6px; background: var(--surface); border-radius: 14px;\n             padding: 7px 9px; border: 1px solid var(--line); box-shadow: 0 6px 20px rgba(0,0,0,.12); max-width: 88%; }\n  .hw .pop::before { content: \"\"; position: absolute; top: -5px; left: 15px; width: 8px; height: 8px;\n                     background: var(--surface); transform: rotate(45deg);\n                     border-left: 1px solid var(--line); border-top: 1px solid var(--line); }\n  .hw .pop .pk { font-size: 7px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink3); }\n  .hw .pop .pt { font-size: 9.5px; line-height: 1.55; color: var(--ink); margin-top: 2px; }\n  .hw .pop .pa { margin-top: 5px; font-size: 8px; color: var(--ink2); }\n  .hw .pop.word { max-width: 78%; }\n  .hw .pop .pb { display: inline-block; margin-top: 5px; font-size: 8px; font-weight: 600; padding: 3px 9px;\n                 border-radius: 20px; background: var(--acc); color: #fff; }\n  .hw .pop .pb.done { background: transparent; color: var(--ink); border: 1px solid var(--ink3); }\n\n  /* bottom tab switch */\n  .hw .tabbar { flex: none; display: flex; gap: 4px; margin: 8px -14px 0; padding: 6px 14px 14px;\n                border-top: 1px solid var(--line); background: var(--bg); }\n  .hw .tb { flex: 1; text-align: center; font-size: 9px; font-weight: 500; color: var(--ink2); padding: 3px 0; }\n  .hw .tb.on { color: var(--acc); font-weight: 600; }\n\n  /* article cover + recent cards, mirroring the lesson cards */\n  .hw .hero-top { display: flex; gap: 8px; align-items: flex-start; }\n  .hw .coverimg { width: 46px; height: 46px; border-radius: 10px; object-fit: cover; flex: none; }\n  .hw .rlist { display: flex; flex-direction: column; gap: 6px; }\n  .hw .rcard { display: flex; gap: 8px; align-items: center; background: var(--surface); border-radius: 12px;\n               padding: 7px 8px; box-shadow: 0 0 0 .5px rgba(0,0,0,.05); }\n  .hw .rth { width: 28px; height: 28px; border-radius: 7px; flex: none;\n             background: linear-gradient(150deg,#cfd8e3,#7f97af); }\n  .hw .rt2 { flex: 1; font-size: 9.5px; line-height: 1.25; color: var(--ink); min-width: 0;\n             display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }\n  .hw .rd2 { font-size: 7.5px; color: var(--ink3); flex: none; font-variant-numeric: tabular-nums; }\n  .hw .rs2 { font-size: 7.5px; font-weight: 600; color: var(--acc); flex: none; }\n\n  /* flip diagram */\n  .hw .flips { display: grid; gap: var(--cds-gap-md, 1rem);\n               grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); }\n  .hw .slice { position: relative; height: 118px; border-radius: 12px; background: var(--bg);\n               border: 1px solid var(--line); padding: 9px; overflow: hidden; font-family: var(--ui); }\n  .hw .slice p { margin: 0; font-size: 8.5px; line-height: 1.6; color: var(--ink2); }\n  .hw .slice .hl2 { background: var(--acc-soft); color: var(--acc-ink); border-radius: 3px; }\n  .hw .slice .pv { position: absolute; left: 9px; right: 9px; background: var(--surface); border: 1px solid var(--line);\n                   border-radius: 10px; padding: 5px 7px; font-size: 8.5px; color: var(--ink);\n                   box-shadow: 0 4px 14px rgba(0,0,0,.10); }\n  .hw .slice .pv.below { top: 62px; }\n  .hw .slice .pv.above { bottom: 62px; }\n\n  /* ---------- phone artboard ---------- */\n  .hw .phone { position: relative; padding: 16px 14px 0; border-radius: 30px; border: 1px solid var(--line);\n               background: var(--bg); box-shadow: 0 10px 30px rgba(0,0,0,.08); overflow: hidden;\n               aspect-ratio: 390 / 760; display: flex; flex-direction: column; font-family: var(--ui); }\n  .hw .phone::after { content: \"\"; position: absolute; left: 50%; bottom: 6px; width: 34%; height: 4px;\n                      transform: translateX(-50%); border-radius: 2px; background: rgba(0,0,0,.16); }\n  .hw .scr { flex: 1; overflow: hidden; display: flex; flex-direction: column; gap: 9px; color: var(--ink); }\n  .hw .micro { font-size: 8px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink3); margin: 0; }\n  .hw .ttl { font-size: 17px; font-weight: 700; letter-spacing: -.03em; margin: 0; color: var(--ink); }\n  .hw .bar { display: flex; align-items: center; justify-content: space-between; }\n  .hw .dash-led { font-size: 16px; font-weight: 600; letter-spacing: -.01em; color: var(--ink); }\n  .hw .iconbtn { width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center;\n                 background: var(--track); color: var(--ink2); font-size: 12px; line-height: 1; }\n\n  .hw .tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; }\n  .hw .tile { border-radius: 14px; padding: 8px 9px; background: var(--surface);\n              box-shadow: 0 0 0 .5px rgba(0,0,0,.05); }\n  .hw .tile b { display: block; font-size: 16px; font-weight: 700; letter-spacing: -.02em; color: var(--ink); }\n  .hw .tile b i { font-style: normal; font-size: 8px; font-weight: 500; color: var(--ink2); margin-left: 2px; }\n  .hw .tile b.fire { color: var(--fire); }\n  .hw .tile b.acc { color: var(--acc); }\n  .hw .tile em { font-style: normal; font-size: 8.5px; color: var(--ink2); font-weight: 500; }\n\n  .hw .hero { border-radius: 16px; padding: 9px; display: flex; gap: 9px; background: var(--surface);\n              box-shadow: 0 0 0 .5px rgba(0,0,0,.05); }\n  .hw .hero.tall { flex-direction: column; gap: 4px; }\n  .hw .cover { width: 46px; height: 46px; border-radius: 10px; flex: none; position: relative;\n               background: linear-gradient(150deg,#b8c6d6,#5f7d9b 72%); }\n  .hw .cover::after { content: \"E\"; position: absolute; inset: 0; display: grid; place-items: center;\n                      font-size: 18px; font-weight: 700; color: #fff; }\n  .hw .hero .hl { font-size: 8.5px; font-weight: 600; color: var(--acc); }\n  .hw .hero .ht { font-size: 11px; font-weight: 600; line-height: 1.25; margin-top: 1px; color: var(--ink); }\n  .hw .hero .hp { font-size: 8.5px; color: var(--ink2); margin-top: 2px; }\n  .hw .hero .cta { margin-top: 6px; font-size: 9px; font-weight: 600; text-align: center; border-radius: 20px;\n                   padding: 5px; background: var(--acc); color: #fff; }\n  .hw .chips { display: flex; gap: 4px; margin-top: 4px; flex-wrap: wrap; }\n  .hw .chip { font-size: 8px; padding: 1px 6px; border-radius: 20px; color: var(--ink2); background: var(--track); }\n  .hw .lrow { display: flex; gap: 8px; align-items: center; padding-top: 7px; border-top: 1px solid var(--line); }\n  .hw .lrow .mini { width: 26px; height: 26px; border-radius: 7px; flex: none;\n                    background: linear-gradient(150deg,#c9d5e2,#6f8ba8); }\n  .hw .lrow .lt { font-size: 9.5px; line-height: 1.3; color: var(--ink); }\n\n  /* recent-article rows, same rhythm as the lesson rows */\n  .hw .rrow { display: flex; gap: 8px; align-items: baseline; padding-top: 7px; border-top: 1px solid var(--line); }\n  .hw .rrow .rd { font-size: 8px; color: var(--ink3); width: 34px; flex: none; font-variant-numeric: tabular-nums; }\n  .hw .rrow .rt { font-size: 9.5px; line-height: 1.3; color: var(--ink); flex: 1;\n                  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }\n  .hw .rrow .rs { font-size: 7.5px; color: var(--acc); flex: none; }\n\n  /* read artboard */\n  .hw .masthead { display: flex; align-items: baseline; gap: 7px; }\n  .hw .masthead b { font-size: 13px; font-weight: 700; letter-spacing: .04em; color: var(--ink); }\n  .hw .masthead span { font-size: 7px; letter-spacing: .16em; color: var(--ink3); text-transform: uppercase; }\n  .hw .paper { border-radius: 16px; background: var(--surface); padding: 10px; box-shadow: 0 0 0 .5px rgba(0,0,0,.05); }\n  .hw .paper .art-t { font-size: 12.5px; font-weight: 700; letter-spacing: -.02em; line-height: 1.25; color: var(--ink); }\n  .hw .paper .art-cn { font-size: 8.5px; color: var(--ink2); margin-top: 3px; }\n  .hw .body-text { font-family: var(--font-anthropic-serif); font-size: 9.5px; line-height: 1.75; color: var(--ink);\n                   margin: 7px 0 0; }\n  .hw .hl-today { border-bottom: 1px dotted var(--ink3); }\n  .hw .hl-book { background: var(--acc-soft); color: var(--acc-ink); border-radius: 2px; }\n\n  /* sheets */\n  .hw .sheet { margin-top: 7px; border-radius: 16px 16px 0 0; background: var(--surface); padding: 8px 9px;\n               box-shadow: 0 -1px 0 rgba(0,0,0,.06); }\n  .hw .sheet .sk2 { font-size: 7px; letter-spacing: .14em; color: var(--ink3); text-transform: uppercase; }\n  .hw .sheet .sv { font-size: 12px; font-weight: 600; letter-spacing: -.01em; color: var(--ink); }\n  .hw .sheet .sd { font-size: 8.5px; color: var(--ink2); line-height: 1.5; }\n  .hw .sheet .sb { margin-top: 6px; font-size: 9px; font-weight: 600; text-align: center; border-radius: 20px; padding: 5px;\n                   background: var(--acc); color: #fff; }\n  .hw .sheet .sent { font-family: var(--font-anthropic-serif); font-size: 10px; color: var(--ink); line-height: 1.5; }\n  .hw .sheet .tr { margin-top: 4px; font-size: 10px; color: var(--ink); line-height: 1.6; }\n\n  /* settings artboard */\n  .hw .setbar { display: flex; justify-content: space-between; align-items: baseline; }\n  .hw .card-s { border-radius: 16px; padding: 9px; background: var(--surface); box-shadow: 0 0 0 .5px rgba(0,0,0,.05); }\n  .hw .card-s h3 { margin: 0 0 4px; font-size: 8px; letter-spacing: .1em; text-transform: uppercase; color: var(--ink2); }\n  .hw .card-s p { margin: 0 0 6px; font-size: 9.5px; color: var(--ink2); }\n  .hw .card-s p b { color: var(--ink); font-weight: 600; }\n  .hw .card-s .row2 { display: flex; gap: 6px; }\n  .hw .btn-s { flex: 1; font-size: 9px; font-weight: 500; text-align: center; padding: 5px 0; border-radius: 20px;\n               background: var(--track); color: var(--ink); }\n  .hw .btn-s.pri { background: var(--acc); color: #fff; }\n  .hw .field-s { border-radius: 9px; padding: 5px 7px; font-size: 8px; color: var(--ink3);\n                 background: var(--track); margin-bottom: 5px; }\n\n  /* ---------- tables and cards ---------- */\n  .hw .card { background: var(--color-panel); border: 1px solid var(--color-border-line);\n              border-radius: var(--cds-radius, 12px); padding: var(--cds-pad-lg, 1.1rem); }\n  .hw .tw { max-height: 22rem; overflow: auto; border-top: 1px solid var(--color-border-line); margin-top: .7rem; }\n  .hw table { width: 100%; border-collapse: collapse; font-size: .8rem; font-variant-numeric: tabular-nums; }\n  .hw th { position: sticky; top: 0; background: var(--color-panel); text-align: left; font-weight: 500;\n           padding: .45rem .5rem; border-bottom: 1px solid var(--color-border-line); white-space: nowrap; }\n  .hw th button { all: unset; cursor: pointer; display: inline-flex; gap: .3rem; align-items: center; }\n  .hw th button:focus-visible { outline: 2px solid var(--color-fg); outline-offset: 2px; border-radius: 3px; }\n  .hw td { padding: .38rem .5rem; border-bottom: 1px solid color-mix(in srgb, var(--color-border-line) 55%, transparent); }\n  .hw td.num { text-align: right; }\n  .hw .bar-cell { position: relative; }\n  .hw .bar-cell i { position: absolute; left: .5rem; right: .5rem; bottom: 2px; height: 3px; border-radius: 2px;\n                    background: var(--color-fg-muted); opacity: .22; transform-origin: left; }\n  .hw .search { margin-top: .2rem; width: 100%; max-width: 18rem; padding: .45rem .6rem; font: inherit; font-size: .8rem;\n                border: 1px solid var(--color-border-line); border-radius: 8px; background: var(--color-bg); color: var(--color-fg); }\n\n  .hw .vocab { display: flex; flex-direction: column; gap: .45rem; margin-top: .6rem; }\n  .hw .vrow { display: grid; grid-template-columns: 5.2rem 1fr auto; gap: .6rem; align-items: center; font-size: .8rem; }\n  .hw .vtrack { height: 10px; border-radius: 5px; background: color-mix(in srgb, var(--color-border-line) 45%, transparent); overflow: hidden; }\n  .hw .vfill { height: 100%; border-radius: 5px; background: #0071E3; opacity: .78; }\n\n  .hw .swatches { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .6rem; }\n  .hw .sw { width: 6.4rem; }\n  .hw .sw i { display: block; height: 2.1rem; border-radius: 8px; border: 1px solid rgba(0,0,0,.06); }\n  .hw .sw span { display: block; font-size: .68rem; color: var(--color-fg-muted); margin-top: .2rem; }\n  .hw ul.q { margin: .5rem 0 0; padding-left: 1.1rem; font-size: .82rem; line-height: 1.75; color: var(--color-fg-muted); }\n  .hw code { font-size: .76rem; background: color-mix(in srgb, var(--color-border-line) 40%, transparent);\n             padding: .05rem .3rem; border-radius: 4px; }\n</style>\n\n<div class=\"hw\">\n  <header>\n    <p class=\"kicker\">HwFee English · Android</p>\n    <h1>界面设计草稿</h1>\n    <p class=\"lead\">精听 tab 保持 cherina-pod 原样，不动。只改两个：词间用它的 token 和骨架重做——日期、标题、四个数、今天这一篇、近几篇，右上角刷新；设置用同一套卡片。精听那张图放着只为对照。</p>\n  </header>\n\n  <section>\n    <h2>骨架</h2>\n    <p class=\"sub\">从 cherina-pod 的课程库页搬过来的结构，词间和设置照着填。</p>\n    <div class=\"card\">\n      <div class=\"skel\">\n        <div class=\"sk\"><b>① 顶行</b><span>左：日期 · 右：一个动作（精听＝导入，词间＝刷新）</span></div>\n        <div class=\"sk\"><b>② 标题</b><span>我的精听 / 我的精读，26px 粗体，左对齐</span></div>\n        <div class=\"sk\"><b>③ 四个数</b><span>两行两列的白色小卡，数字用粗体</span></div>\n        <div class=\"sk\"><b>④ 主卡</b><span>精听＝继续这一课；词间＝今天这一篇。蓝底按钮在卡里</span></div>\n        <div class=\"sk\"><b>⑤ 列表</b><span>课程库 / 近几篇，同样的行高与分隔线</span></div>\n      </div>\n    </div>\n  </section>\n\n  <section>\n    <h2>三个界面</h2>\n    <p class=\"sub\">左一是精听，原样不动，只为对照；右边两个是要改的。灰色破折号是 app 本地状态，还没接进来。</p>\n    <div class=\"grid3\">\n\n      <figure>\n        <figcaption>精听 <span>原样，不动</span></figcaption>\n        <div class=\"phone\">\n          <div class=\"scr\">\n            <div class=\"bar\">\n              <p class=\"micro\" data-source=\"today\" data-field=\"date\" data-row=\"0\">—</p>\n              <span class=\"iconbtn\" title=\"导入课程\">⤓</span>\n            </div>\n            <p class=\"ttl\">我的精听</p>\n            <div class=\"tiles\">\n              <div class=\"tile\"><em>连续</em><b class=\"fire\">—<i>天</i></b></div>\n              <div class=\"tile\"><em>今天</em><b>—<i>分钟</i></b></div>\n              <div class=\"tile\"><em>累计完成</em><b>—<i>段</i></b></div>\n              <div class=\"tile\"><em>待复习</em><b class=\"acc\">—<i>句</i></b></div>\n            </div>\n            <div class=\"hero\">\n              <div class=\"cover\"></div>\n              <div>\n                <div class=\"hl\">继续这一课</div>\n                <div class=\"ht\" id=\"hw-hero-title\">—</div>\n                <div class=\"hp\" id=\"hw-hero-podcast\">—</div>\n                <div class=\"chips\">\n                  <span class=\"chip\"><span data-source=\"lessons\" data-field=\"minutes\" data-row=\"0\">—</span> 分钟</span>\n                  <span class=\"chip\"><span data-source=\"lessons\" data-field=\"wpm\" data-row=\"0\">—</span> 词/分</span>\n                  <span class=\"chip\"><span data-source=\"lessons\" data-field=\"segments\" data-row=\"0\">—</span> 段</span>\n                </div>\n              </div>\n            </div>\n            <p class=\"micro\">课程库</p>\n            <div class=\"lrow\"><div class=\"mini\"></div><div class=\"lt\" id=\"hw-row2\">—</div></div>\n            <div class=\"lrow\"><div class=\"mini\"></div><div class=\"lt\" id=\"hw-row3\">—</div></div>\n            <div class=\"lrow\"><div class=\"mini\"></div><div class=\"lt\" id=\"hw-row4\">—</div></div>\n          </div>\n        </div>\n          <div class=\"tabbar\"><span class=\"tb on\">精听</span><span class=\"tb\">阅读</span><span class=\"tb\">设置</span></div>\n        <p class=\"note\">这个 tab 现在就能用：课程库、播放页都是 cherina-pod 自己生成的，这次一行不改。</p>\n      </figure>\n\n      <figure>\n        <figcaption>词间 <span>同一骨架，刷新在顶行</span></figcaption>\n        <div class=\"phone\">\n          <div class=\"scr\">\n            <div class=\"bar\">\n              <p class=\"micro\" data-source=\"today\" data-field=\"date\" data-row=\"0\">—</p>\n              <span class=\"iconbtn\" title=\"刷新今天的一篇\">↻</span>\n            </div>\n            <p class=\"ttl\">我的精读</p>\n            <div class=\"tiles\">\n              <div class=\"tile\"><em>今日新词</em><b><span data-source=\"today\" data-field=\"new_done\" data-row=\"0\">—</span><i>/<span data-source=\"today\" data-field=\"new_total\" data-row=\"0\">—</span></i></b></div>\n              <div class=\"tile\"><em>复习</em><b><span data-source=\"today\" data-field=\"review_done\" data-row=\"0\">—</span><i>/<span data-source=\"today\" data-field=\"review_total\" data-row=\"0\">—</span></i></b></div>\n              <div class=\"tile\"><em>生词本</em><b class=\"acc\"><span data-source=\"vocab\" data-field=\"words\" data-where=\"category=wordbook\">—</span><i>词</i></b></div>\n              <div class=\"tile\"><em>已掌握</em><b><span data-source=\"vocab\" data-field=\"words\" data-where=\"category=learned\">—</span><i>词</i></b></div>\n            </div>\n            <div class=\"hero tall\">\n              <div class=\"hero-top\">\n                <img class=\"coverimg\" src=\"data:image/jpeg;base64,\" alt=\"今天这篇的封面\">\n                <div>\n                  <div class=\"hl\">今天的一篇 · <span data-source=\"today\" data-field=\"book\" data-row=\"0\">—</span></div>\n                  <div class=\"ht\" id=\"hw-art-title\" style=\"font-size:11.5px\">—</div>\n                </div>\n              </div>\n              <div class=\"hp\" id=\"hw-art-cn\">—</div>\n              <div class=\"chips\">\n                <span class=\"chip\"><span data-source=\"article\" data-field=\"words\" data-row=\"0\">—</span> 词</span>\n                <span class=\"chip\"><span data-source=\"article\" data-field=\"paragraphs\" data-row=\"0\">—</span> 段</span>\n                <span class=\"chip\">约 <span data-source=\"article\" data-field=\"minutes\" data-row=\"0\">—</span> 分钟</span>\n              </div>\n              <div class=\"cta\">开始读这一篇</div>\n            </div>\n            <p class=\"micro\">近几篇</p>\n            <div class=\"rlist\" id=\"hw-recent\" data-source=\"recent\"></div>\n          </div>\n        </div>\n          <div class=\"tabbar\"><span class=\"tb\">精听</span><span class=\"tb on\">阅读</span><span class=\"tb\">设置</span></div>\n        <p class=\"note\">顶上那个 ↻ 是刷新：抓今天的短文，顺带刷新词表数字。列表是已抓回来过的篇目，今天那行标「今天」，点一行就打开旧文。</p>\n      </figure>\n\n      <figure>\n        <figcaption>词间 · 交互 <span>长按与点词</span></figcaption>\n        <div class=\"phone\">\n          <div class=\"scr\">\n            <div class=\"masthead\"><b>词间</b><span>Between the words</span></div>\n            <div class=\"paper\">\n              <div class=\"art-t\" id=\"hw-art-title-2\">—</div>\n              <div class=\"art-cn\" id=\"hw-art-cn-2\">—</div>\n              <p class=\"body-text\" id=\"hw-excerpt\">—</p>\n              <p class=\"sent-line body-text\" style=\"margin-top:4px\"><mark>Oysters were once food for the poor.</mark></p>\n              <div class=\"pop\">\n                <div class=\"pk\">译文 · 长按句子</div>\n                <div class=\"pt\">生蚝曾经是穷人吃的食物。</div>\n                <div class=\"pa\">点浮层外关闭 · 不压住被翻的句子</div>\n              </div>\n              <p class=\"sent-line body-text\" style=\"margin-top:10px\">Ancient Romans also <mark>dined</mark> on snails.</p>\n              <div class=\"pop word\">\n                <div class=\"pk\">Word · 点词</div>\n                <div class=\"pt\"><b>dined</b> <span style=\"color:var(--ink2);font-size:8.5px\">v. 进餐；用饭（dine 的过去式）</span></div>\n                <div class=\"pb done\">已在生词本 · 移除</div>\n              </div>\n            </div>\n          </div>\n        </div>\n          <div class=\"tabbar\"><span class=\"tb\">精听</span><span class=\"tb on\">阅读</span><span class=\"tb\">设置</span></div>\n        <p class=\"note\">两个手势都是贴着文字的浮层：长按句子=整句翻译，点单词=释义加生词本按钮。浮层都避开被点的那一句或那个词，同一个时刻只开一个。</p>\n      </figure>\n\n      <figure>\n        <figcaption>设置 <span>同一套 token</span></figcaption>\n        <div class=\"phone\">\n          <div class=\"scr\">\n            <div class=\"setbar\"><span class=\"dash-led\">设置</span><span style=\"font-size:9.5px;color:var(--acc);font-weight:500\">完成</span></div>\n            <div class=\"card-s\">\n              <h3>扇贝</h3>\n              <p>已连接 · <b data-source=\"today\" data-field=\"book\" data-row=\"0\">—</b></p>\n              <div class=\"row2\"><div class=\"btn-s pri\">网页登录</div><div class=\"btn-s\">粘贴 Cookie</div></div>\n            </div>\n            <div class=\"card-s\">\n              <h3>翻译</h3>\n              <p>已配置 · deepseek-chat</p>\n              <div class=\"field-s\">sk-············</div>\n              <div class=\"row2\"><div class=\"btn-s pri\">保存</div><div class=\"btn-s\">清除密钥</div></div>\n            </div>\n            <div class=\"card-s\">\n              <h3>课程库</h3>\n              <p><span data-source=\"lessonTotals\" data-field=\"value\" data-where=\"metric=课程\">—</span> 节课 · <span data-source=\"lessonTotals\" data-field=\"value\" data-where=\"metric=总时长\">—</span> 分钟</p>\n            </div>\n          </div>\n        </div>\n          <div class=\"tabbar\"><span class=\"tb\">精听</span><span class=\"tb\">阅读</span><span class=\"tb on\">设置</span></div>\n        <p class=\"note\">省掉列表，其余照骨架：卡片十六圆角、白底、0.5px 描边。</p>\n      </figure>\n\n    </div>\n  </section>\n\n  <section>\n    <h2>浮层的位置规则</h2>\n    <p class=\"sub\">句子和单词用同一套规则：先试下方，放不下就翻到上方，被点的那一段永远保持可见。</p>\n    <div class=\"card\">\n      <div class=\"flips\">\n        <div>\n          <p class=\"sub\" style=\"margin-bottom:.45rem\">句子在上半屏 → 浮层出现在句子下方</p>\n          <div class=\"slice\">\n            <p>To most people, Provence is a region of France. <span class=\"hl2\">Increasingly, it is also a lifestyle brand.</span></p>\n            <div class=\"pv below\">越来越多人还把它当成一种生活方式品牌。</div>\n          </div>\n        </div>\n        <div>\n          <p class=\"sub\" style=\"margin-bottom:.45rem\">句子靠近底部 → 浮层翻到句子上面</p>\n          <div class=\"slice\">\n            <p style=\"position:absolute;left:9px;right:9px;bottom:9px\">The word \"Provence\" evokes the sound of cicadas and the smell of pine. <span class=\"hl2\">Few other places carry so much meaning.</span></p>\n            <div class=\"pv above\">少有其他地方承载这么多含义。</div>\n          </div>\n        </div>\n      </div>\n      <ul class=\"q\">\n        <li>水平方向从被点文字的左边缘开始，超出一边就往回收，始终留一屏边距。</li>\n        <li>词的浮层比句子的窄（最多七成宽），同样先试下方再翻上方；一个时刻只开一个浮层，点别处就关。</li>\n        <li>两边都放不下时，浮层压到旁边的段落上，但被点的那一句或那个词仍在视野里，点浮层外即关。</li>\n        <li>滚动文章时浮层跟着它走；它滚出屏幕就关掉，不留一个飘在半空的框。</li>\n      </ul>\n    </div>\n  </section>\n\n  <section>\n    <h2>课程库的真实内容</h2>\n    <p class=\"sub\">你导入过的 39 节课。点表头排序，输入框过滤。</p>\n    <div class=\"card\">\n      <input class=\"search\" id=\"hw-search\" type=\"search\" placeholder=\"搜索课程或播客\" aria-label=\"搜索课程\">\n      <div class=\"tw\">\n        <table id=\"hw-table\" data-source=\"lessons\" data-row-key=\"title\">\n          <thead>\n            <tr>\n              <th><button data-sort=\"title\">课程</button></th>\n              <th><button data-sort=\"podcast\">播客</button></th>\n              <th><button data-sort=\"minutes\">分钟</button></th>\n              <th><button data-sort=\"segments\">段</button></th>\n              <th><button data-sort=\"wpm\">语速</button></th>\n            </tr>\n          </thead>\n          <tbody></tbody>\n        </table>\n      </div>\n    </div>\n  </section>\n\n  <section>\n    <h2>词汇分类</h2>\n    <p class=\"sub\">高亮的来源。生词本是你要主动认出来的那批，今日学习是今天会碰到的。</p>\n    <div class=\"card\" data-source=\"vocab\">\n      <div class=\"vocab\" id=\"hw-vocab\"></div>\n    </div>\n  </section>\n\n  <section>\n    <h2>Token 表</h2>\n    <p class=\"sub\">全部取自 cherina-pod 的 <code>:root</code>，另外补上它的深色值。</p>\n    <div class=\"card\">\n      <div class=\"swatches\">\n        <div class=\"sw\"><i style=\"background:#F5F5F7\"></i><span>--bg #F5F5F7</span></div>\n        <div class=\"sw\"><i style=\"background:#FFFFFF\"></i><span>--surface #FFFFFF</span></div>\n        <div class=\"sw\"><i style=\"background:#1D1D1F\"></i><span>--ink #1D1D1F</span></div>\n        <div class=\"sw\"><i style=\"background:#6E6E73\"></i><span>--ink2 #6E6E73</span></div>\n        <div class=\"sw\"><i style=\"background:#AEAEB2\"></i><span>--ink3 #AEAEB2</span></div>\n        <div class=\"sw\"><i style=\"background:#E5E5EA\"></i><span>--line #E5E5EA</span></div>\n        <div class=\"sw\"><i style=\"background:#0071E3\"></i><span>--acc #0071E3</span></div>\n        <div class=\"sw\"><i style=\"background:#FF6B00\"></i><span>--fire #FF6B00</span></div>\n        <div class=\"sw\"><i style=\"background:#000000\"></i><span>深色 --bg #000</span></div>\n        <div class=\"sw\"><i style=\"background:#1C1C1E\"></i><span>深色 --surface #1C1C1E</span></div>\n        <div class=\"sw\"><i style=\"background:#2997FF\"></i><span>深色 --acc #2997FF</span></div>\n      </div>\n      <ul class=\"q\">\n        <li>圆角：小控件十四，卡片十六，弹层二十；描边统一 <code>0 0 0 .5px rgba(0,0,0,.05)</code>，不用投影。</li>\n        <li>缓动 <code>cubic-bezier(.22,.8,.24,1)</code>；动效只在 <code>prefers-reduced-motion: no-preference</code> 下跑。</li>\n        <li>字体：界面用系统栈；阅读正文是唯一的例外，保留衬线。</li>\n        <li>深色模式直接映射 podcast 的 <code>prefers-color-scheme: dark</code> 分支，两 tab 一起切。</li>\n      </ul>\n    </div>\n  </section>\n\n  <section>\n    <h2>还需要你定的两件事</h2>\n    <div class=\"card\">\n      <ul class=\"q\">\n        <li>刷新只抓今天的一篇，还是顺带把词表数字也重拉一遍？现在设计成两个一起。</li>\n        <li>词间标题用「我的精读」对齐精听的「我的精听」，还是保留原来的「词间」加一行小字？</li>\n      </ul>\n    </div>\n  </section>\n</div>\n\n<script>\n  (function () {\n    const $ = (s) => document.querySelector(s);\n    const num = (v) => Number(v);\n    const setText = (sel, value) => { const el = $(sel); if (el) el.textContent = value; };\n\n    // Declared before dash.onData runs its first pass, which happens synchronously.\n    let sortKey = 'title';\n    let sortDir = 1;\n    let query = '';\n\n    dash.calc('lessonTotals', {\n      inputs: ['lessons'],\n      title: '课程库合计',\n      description: '节数与总时长，由课程表的行相加。',\n      fn: (lessons) => ([\n        { metric: '课程', value: lessons.length },\n        { metric: '总时长', value: Math.round(lessons.reduce((sum, l) => sum + num(l.minutes), 0)) },\n      ]),\n    });\n\n    dash.onData(() => {\n      const lessons = dash.data('lessons');\n      const article = dash.data('article');\n      const recent = dash.data('recent');\n      const vocab = dash.data('vocab');\n\n      const rows = lessons.status === 'ok' ? lessons.data : [];\n      const art = article.status === 'ok' ? article.data[0] : null;\n      const list = recent.status === 'ok' ? recent.data : [];\n      const cats = vocab.status === 'ok' ? vocab.data : [];\n\n      if (rows.length) {\n        setText('#hw-hero-title', rows[0].title);\n        setText('#hw-hero-podcast', rows[0].podcast);\n        setText('#hw-row2', rows[1] ? rows[1].title : '—');\n        setText('#hw-row3', rows[2] ? rows[2].title : '—');\n        setText('#hw-row4', rows[3] ? rows[3].title : '—');\n      }\n      if (art) {\n        setText('#hw-art-title', art.title);\n        setText('#hw-art-cn', art.title_cn);\n        setText('#hw-art-title-2', art.title);\n        setText('#hw-art-cn-2', art.title_cn);\n        setText('#hw-excerpt', art.excerpt);\n      }\n\n      paintMarks();\n      drawTable(rows);\n      drawVocab(cats);\n      drawRecent(list);\n    });\n\n    // Every marked element shows its dataset value exactly as the file holds it.\n    function paintMarks() {\n      for (const el of document.querySelectorAll('[data-source][data-field]')) {\n        const state = dash.data(el.dataset.source);\n        if (state.status !== 'ok' || !Array.isArray(state.data)) continue;\n        const row = el.dataset.where\n          ? state.data.find((candidate) => whereMatches(candidate, el.dataset.where))\n          : state.data[Number(el.dataset.row || 0)];\n        if (!row) continue;\n        const value = row[el.dataset.field];\n        if (value !== undefined && value !== null) el.textContent = String(value);\n      }\n    }\n\n    function whereMatches(row, where) {\n      return where.split('&').every((pair) => {\n        const split = pair.indexOf('=');\n        const key = decodeURIComponent(pair.slice(0, split));\n        const expected = decodeURIComponent(pair.slice(split + 1));\n        return String(row[key]) === expected;\n      });\n    }\n\n    // --------------------------------------------------------------- recent\n    function drawRecent(rows) {\n      const host = $('#hw-recent');\n      if (!host) return;\n      host.replaceChildren();\n      for (const row of rows.slice(0, 3)) {\n        const card = document.createElement('div');\n        card.className = 'rcard';\n        const thumb = document.createElement('div');\n        thumb.className = 'rth';\n        const title = document.createElement('span');\n        title.className = 'rt2';\n        title.textContent = row.title;\n        card.append(thumb, title);\n        if (row.state === '今天') {\n          const state = document.createElement('span');\n          state.className = 'rs2';\n          state.textContent = '今天';\n          card.append(state);\n        } else {\n          const date = document.createElement('span');\n          date.className = 'rd2';\n          date.textContent = String(row.date).slice(5).replace('-', '/');\n          card.append(date);\n        }\n        host.append(card);\n      }\n    }\n\n    // ---------------------------------------------------------------- table\n    function drawTable(rows) {\n      const body = $('#hw-table tbody');\n      if (!body) return;\n      const filtered = rows\n        .filter((r) => !query || (r.title + ' ' + r.podcast).toLowerCase().includes(query))\n        .slice()\n        .sort((a, b) => {\n          const av = a[sortKey], bv = b[sortKey];\n          const isNum = sortKey === 'minutes' || sortKey === 'segments' || sortKey === 'wpm';\n          return (isNum ? num(av) - num(bv) : String(av).localeCompare(String(bv))) * sortDir;\n        });\n\n      const maxWpm = Math.max(...rows.map((r) => num(r.wpm)), 1);\n      body.replaceChildren();\n      for (const row of filtered) {\n        const tr = document.createElement('tr');\n        tr.dataset.key = row.title;\n        tr.append(\n          cell(row.title),\n          cell(row.podcast),\n          cell(Number(row.minutes).toFixed(1), 'num'),\n          cell(row.segments, 'num'),\n          barCell(Number(row.wpm), maxWpm),\n        );\n        body.append(tr);\n      }\n      for (const th of document.querySelectorAll('#hw-table th button')) {\n        th.closest('th').setAttribute('aria-sort',\n          th.dataset.sort === sortKey ? (sortDir === 1 ? 'ascending' : 'descending') : 'none');\n      }\n    }\n\n    function cell(text, cls) {\n      const td = document.createElement('td');\n      td.textContent = text;\n      if (cls) td.className = cls;\n      return td;\n    }\n\n    function barCell(value, max) {\n      const td = document.createElement('td');\n      td.className = 'num bar-cell';\n      td.textContent = value;\n      const bar = document.createElement('i');\n      bar.style.transform = 'scaleX(' + (value / max).toFixed(3) + ')';\n      td.append(bar);\n      return td;\n    }\n\n    for (const button of document.querySelectorAll('#hw-table th button')) {\n      button.addEventListener('click', () => {\n        const key = button.dataset.sort;\n        if (key === sortKey) sortDir = -sortDir; else { sortKey = key; sortDir = 1; }\n        drawTable(dash.data('lessons').status === 'ok' ? dash.data('lessons').data : []);\n      });\n    }\n\n    const search = $('#hw-search');\n    if (search) {\n      search.addEventListener('input', () => {\n        query = search.value.trim().toLowerCase();\n        drawTable(dash.data('lessons').status === 'ok' ? dash.data('lessons').data : []);\n      });\n    }\n\n    // ----------------------------------------------------------------- vocab\n    function drawVocab(cats) {\n      const host = $('#hw-vocab');\n      if (!host) return;\n      const max = Math.max(...cats.map((c) => num(c.words)), 1);\n      host.replaceChildren();\n      for (const cat of cats) {\n        const row = document.createElement('div');\n        row.className = 'vrow';\n        const label = document.createElement('span');\n        label.textContent = cat.label;\n        const track = document.createElement('div');\n        track.className = 'vtrack';\n        const fill = document.createElement('div');\n        fill.className = 'vfill';\n        fill.style.width = (num(cat.words) / max * 100).toFixed(1) + '%';\n        track.append(fill);\n        const value = document.createElement('span');\n        value.textContent = num(cat.words).toLocaleString('zh-CN');\n        row.append(label, track, value);\n        host.append(row);\n      }\n    }\n  })();\n</script>\n"
}
